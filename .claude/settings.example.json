{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/hooks/archive-workspace-file-pre-tool-use.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/hooks/validate-brief-post-tool-use.cjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git checkout -b *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(node .claude/scripts/validate-brief.ts *)",
      "Bash(node .claude/scripts/migrate-brief.ts *)",
      "Bash(node .claude/scripts/setup-hooks.ts)"
    ]
  }
}
